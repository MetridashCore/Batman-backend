{
  "name": "batman-backend",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "type": "module",
  "description": "Payment gateway integration for Razorpay and Stripe.",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": "MetridashCore/Batman-backend",
