  "bugs": {
    "url": "https://github.com/MetridashCore/Batman-backend/issues"
  },
  "homepage": "https://github.com/MetridashCore/Batman-backend#readme",
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@sentry/node": "^10.74.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "razorpay": "^2.9.8",
    "stripe": "^22.6.2",
